# ScamShield AI - Environment Configuration

# Flask Application
SECRET_KEY=scamshield-super-secret-key-change-in-production-2026
FLASK_ENV=development
DEBUG=True
PORT=5000

# Database Configuration (MySQL 8)
# If MySQL is not running locally, the application gracefully falls back to SQLite for local development
DB_USER=scamshield_user
DB_PASSWORD=scamshield_pass
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=scamshield_db
# Direct URI override (optional):
# DATABASE_URL=mysql+pymysql://scamshield_user:scamshield_pass@127.0.0.1:3306/scamshield_db

# File Upload Security
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload size
UPLOAD_FOLDER=uploads

# Tesseract OCR Executable Path (Windows default fallback)
# Set your local tesseract.exe path if not in standard PATH
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
